{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {"CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "0", "HARNESS_LINT_CMD": "pnpm exec biome check --error-on-warnings --no-errors-on-unmatched", "HARNESS_PROTECTED_BRANCHES": "main", "HARNESS_TEST_CMD": "pnpm test", "MCP_TIMEOUT": "120000"},
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree remove:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(gh api user --jq .login)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm preview:*)",
      "Bash(pnpm e2e:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run preview:*)",
      "Bash(pnpm run e2e:*)",
      "Bash(pnpm exec biome:*)",
      "Bash(pnpm exec playwright test:*)",
      "Bash(pnpm install --frozen-lockfile:*)",
      "Bash(gh release view:*)",
      "Bash(gh release list:*)",
      "Bash(openspec:*)",
      "mcp__playwright__*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(!.env.example)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/op/**)",
      "Read(~/.config/gh/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(sudo:*)"
    ],
    "ask": [
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh repo create:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh release create:*)",
      "Bash(gh release upload:*)",
      "Bash(gh release delete-asset:*)",
      "Bash(gh workflow run:*)",
      "Bash(pnpm publish:*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": ["git", "git *", "gh", "gh *"],
    "filesystem": {
      "denyRead": ["~/.ssh", "~/.aws", "~/.gnupg", "~/.config/op", "~/.config/gh"]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "release-assets.githubusercontent.com",
        "registry.npmjs.org",
        "pypi.org",
        "files.pythonhosted.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "raw.githubusercontent.com",
        "fonts.googleapis.com",
        "fonts.gstatic.com"
      ],
      "allowLocalBinding": true
    }
  },
  "extraKnownMarketplaces": {
    "agentic-harness": {
      "source": { "source": "github", "repo": "joe-yama/agentic-harness", "ref": "v0.2.0" }
    }
  },
  "enabledPlugins": { "harness@agentic-harness": true },
  "enabledMcpjsonServers": ["playwright"]
}
