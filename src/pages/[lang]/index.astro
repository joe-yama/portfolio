---
import PhotoPicture from '../../components/PhotoPicture.astro';
import PixelArt from '../../components/pixel/PixelArt.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPhotos, getProfile } from '../../lib/content';
import { locales, toLocale } from '../../lib/i18n';
import { camera } from '../../lib/pixel';
import { languageSwitch, navLinks } from '../../lib/site';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const base = import.meta.env.BASE_URL;
const profile = await getProfile(lang);
const sw = languageSwitch(Astro.url.pathname, lang, base);
// 代表写真。validatePhotos が「ちょうど 1 枚」を保証しているので、見つからない = 写真が 0 枚
const featured = (await getPhotos()).find((p) => p.data.featured);
if (!featured) throw new Error('featured: true の写真が 1 枚も無い');
---

<BaseLayout>
  <div class="hero"><PhotoPicture photo={featured} lang={lang} variant="full" eager /></div>
  <div class="art"><PixelArt rows={camera} /></div>
  <h1>{profile.name}</h1>
  <p class="muted">{profile.tagline}</p>

  <nav class="links">
    {profile.links.map((link) => <a href={link.url}>{link.label}</a>)}
  </nav>

  <nav class="links">
    {navLinks(lang, base).map((link) => <a href={link.href}>{link.label}</a>)}
    <a href={sw.href} hreflang={sw.hreflang} lang={sw.hreflang}>
      {sw.label}
    </a>
  </nav>
</BaseLayout>

<style>
  .hero {
    margin-bottom: 2rem;
  }

  .art {
    margin-bottom: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
  }
</style>
