---
import PhotoPicture from '../../components/PhotoPicture.astro';
import PixelArt from '../../components/pixel/PixelArt.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPhotos, getProfile } from '../../lib/content';
import { locales, toLocale } from '../../lib/i18n';
import { camera, github, linkedin } from '../../lib/pixel';
import { languageSwitch, navLinks, ui } from '../../lib/site';

/** 連絡先リンクの kind に対応するドット絵。github/linkedin 以外は spec 通りアイコンなし */
const contactIcons: Partial<Record<string, readonly string[]>> = { github, linkedin };

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const base = import.meta.env.BASE_URL;
const profile = await getProfile(lang);
const sw = languageSwitch(Astro.url.pathname, lang, base);
// 代表写真。validatePhotos が「ちょうど 1 枚」を保証しているので、見つからない = 写真が 0 枚
const featured = (await getPhotos()).find((p) => p.data.featured);
if (!featured) throw new Error('featured: true の写真が 1 枚も無い');
---

<BaseLayout>
  <div class="hero"><PhotoPicture photo={featured} lang={lang} variant="full" eager /></div>
  <div class="art"><PixelArt rows={camera} /></div>
  <h1>{profile.name}</h1>
  <p class="muted">{profile.tagline}</p>

  <nav class="links" aria-label={ui[lang].siteNav}>
    {navLinks(lang, base).map((link) => (
      <a href={link.href}>
        <PixelArt rows={link.icon} scale={1} />
        {link.label}
      </a>
    ))}
    <a href={sw.href} hreflang={sw.hreflang} lang={sw.hreflang}>
      <PixelArt rows={sw.icon} scale={1} />
      {sw.label}
    </a>
  </nav>

  <ul class="links">
    {profile.links.map((link) => {
      const icon = contactIcons[link.kind];
      return (
        <li>
          <a href={link.url}>
            {icon && <PixelArt rows={icon} scale={1} />}
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .hero {
    --photo-max-height: max(12rem, 100svh - 27rem);
    margin-bottom: 2rem;
  }

  .art {
    margin-bottom: 1rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    list-style: none;
    padding: 0;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 0.35em;
  }
</style>
