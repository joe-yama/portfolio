---
import PhotoPicture from '../../components/PhotoPicture.astro';
import PixelArt from '../../components/pixel/PixelArt.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeaturedPhoto, getProfile } from '../../lib/content';
import { locales, toLocale } from '../../lib/i18n';
import { camera, github, linkedin } from '../../lib/pixel';
import { languageSwitch, navLinks, ui } from '../../lib/site';

/** 連絡先リンクの kind に対応するドット絵。github/linkedin 以外は spec 通りアイコンなし */
const contactIcons: Partial<Record<string, readonly string[]>> = { github, linkedin };

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const base = import.meta.env.BASE_URL;
const profile = await getProfile(lang);
const sw = languageSwitch(Astro.url.pathname, lang, base);
const featured = await getFeaturedPhoto();
---

<BaseLayout>
  <div class="hero"><PhotoPicture photo={featured} lang={lang} variant="full" priority /></div>
  <div class="art"><PixelArt rows={camera} /></div>
  <h1>{profile.name}</h1>
  <p class="muted">{profile.tagline}</p>

  <nav class="links" aria-label={ui[lang].siteNav}>
    {navLinks(lang, base).map((link) => (
      <a href={link.href}>
        <PixelArt rows={link.icon} scale={1} />
        {link.label}
      </a>
    ))}
    <span class="lang-switch" role="group" aria-label={sw.label}>
      <PixelArt rows={sw.icon} scale={1} />
      {sw.items.map((item, i) => (
        <Fragment>
          {i > 0 && <span aria-hidden="true">/</span>}
          {item.href ? (
            <a href={item.href} hreflang={item.lang} lang={item.lang}>
              {item.label}
            </a>
          ) : (
            <span lang={item.lang} aria-current="true">
              {item.label}
            </span>
          )}
        </Fragment>
      ))}
    </span>
  </nav>

  <ul class="links">
    {profile.links.map((link) => {
      const icon = contactIcons[link.kind];
      return (
        <li>
          <a href={link.url}>
            {icon && <PixelArt rows={icon} scale={1} />}
            {link.label}
          </a>
        </li>
      );
    })}
  </ul>
</BaseLayout>

<style>
  .hero {
    /* 写真の高さ上限は svh（アドレスバーが出ている最小の高さ）で決める。
       dvh にするとスクロールでバーが隠れるたびに写真の高さが変わる */
    --photo-max-height: max(12rem, 100svh - 27rem);
    margin-bottom: 2rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    list-style: none;
    padding: 0;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 0.35em;
  }

  /* 言語切り替え（design D2）。ヘッダーと違い区切り線は付けない */
  .lang-switch {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
  }
  .lang-switch :global(svg) {
    align-self: center;
  }
  .lang-switch [aria-current] {
    font-weight: 700;
  }
</style>
