---
import PhotoPicture from '../../components/PhotoPicture.astro';
import PixelArt from '../../components/pixel/PixelArt.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeaturedPhoto, getProfile } from '../../lib/content';
import { locales, toLocale } from '../../lib/i18n';
import { camera, github, linkedin } from '../../lib/pixel';
import { languageSwitch, navLinks, ui } from '../../lib/site';

/** 連絡先リンクの kind に対応するドット絵。github/linkedin 以外は spec 通りアイコンなし */
const contactIcons: Partial<Record<string, readonly string[]>> = { github, linkedin };

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = toLocale(Astro.params.lang);
const base = import.meta.env.BASE_URL;
const profile = await getProfile(lang);
const sw = languageSwitch(Astro.url.pathname, lang, base);
const featured = await getFeaturedPhoto();
---

<BaseLayout>
  <div class="top">
    <div class="hero"><PhotoPicture photo={featured} lang={lang} variant="full" priority /></div>
    <div class="intro">
      <div class="art"><PixelArt rows={camera} /></div>
      <h1>{profile.name}</h1>
      <p class="headline">{profile.headline}</p>
      <p class="muted">{profile.tagline}</p>

      <nav class="links" aria-label={ui[lang].siteNav}>
        {navLinks(lang, base).map((link) => (
          <a href={link.href}>
            <PixelArt rows={link.icon} scale={1} />
            {link.label}
          </a>
        ))}
        <a href={sw.href} hreflang={sw.hreflang} lang={sw.hreflang}>
          <PixelArt rows={sw.icon} scale={1} />
          {sw.label}
        </a>
      </nav>

      <ul class="links">
        {profile.links.map((link) => {
          const icon = contactIcons[link.kind];
          return (
            <li>
              <a href={link.url}>
                {icon && <PixelArt rows={icon} scale={1} />}
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    /* 写真の高さ上限は svh（アドレスバーが出ている最小の高さ）で決める。
       dvh にするとスクロールでバーが隠れるたびに写真の高さが変わる。
       30rem は写真の下に並ぶ文字列（ドット絵・名前・仕事の一行・肩書・導線・連絡先）と
       ヘッダー・main の余白の見積もりに、2rem の余裕を足したもの */
    --photo-max-height: max(12rem, 100svh - 30rem);
    margin-bottom: 2rem;
  }

  /* 64rem 以上では写真を左、文字列を右に並べる（design D5）。範囲構文は使わない */
  @media (min-width: 64rem) {
    .top {
      display: grid;
      grid-template-columns: 3fr 2fr;
      align-items: center;
      gap: 2rem;
    }

    .hero {
      /* 写真の下に文字が来ないので、ヘッダー（約 4rem）と main の上下の余白（2rem × 2）に
         2rem の余裕を足した 10rem だけを引く */
      --photo-max-height: max(12rem, 100svh - 10rem);
      margin-bottom: 0;
    }
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    list-style: none;
    padding: 0;
  }

  .links a {
    display: flex;
    align-items: center;
    gap: 0.35em;
  }
</style>
