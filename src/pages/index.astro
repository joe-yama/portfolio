---
// 設計書 §4 の静的リダイレクト。Astro の redirectToDefaultLocale は
// ルート index.astro の存在を要求し競合 WARN を出すため自前で書く
import { assetPath, homePath } from '../lib/site';

const base = import.meta.env.BASE_URL;
const top = homePath('ja', base);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${top}`} />
    <meta name="robots" content="noindex" />
    <title>portfolio</title>
    <link rel="icon" href={assetPath('/favicon.svg', base)} type="image/svg+xml" />
  </head>
  <body>
    <a href={top}>Redirecting from <code>/</code> to <code>{top}</code></a>
  </body>
</html>
