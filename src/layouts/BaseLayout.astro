---
// 全ページ共通の殻（design D1）。<head> のメタデータ、Header、<main><slot/>、Footer。
// ページは本文だけを書く。hreflang は /ja/ /en/ 配下のページだけに出す（404 は対象外）
import { Font, getImage } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getPhotos, getProfile } from '../lib/content';
import { defaultLocale, localeFromPath, withBase } from '../lib/i18n';
import { absoluteUrl, alternateLinks, canonicalUrl, ogLocale } from '../lib/site';
import '../styles/global.css';

interface Props {
  /** ページ名。省略時はトップ扱いで名前のみ */
  title?: string;
  showNav?: boolean;
}

const { title, showNav } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
// lang は URL から導く。接頭辞の無いページ（404）は既定ロケール
const pathLocale = localeFromPath(path, base);
const lang = pathLocale ?? defaultLocale;
const profile = await getProfile(lang);
if (!Astro.site) throw new Error('astro.config の site が必要（hreflang の絶対 URL に使う）');
const alternates = pathLocale ? alternateLinks(path, Astro.site, base) : [];
// canonical と description は hreflang と同じ条件で出す（404 には出さない。design D6）
const canonical = pathLocale ? canonicalUrl(path, Astro.site, base) : null;
const description = pathLocale ? profile.tagline : null;
const pageTitle = title ? `${title} · ${profile.name}` : profile.name;

// 共有カード（design D3）。canonical / description と同じ条件でだけ出す。
// 幅と高さは getImage の呼び出しと meta の出力で 1 か所の定数を共有する
// （別々に持つと、片方だけ変わってもテストの meta 値チェックが実際の画像とのずれを検知できない）
const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 630;
let ogImage: { src: string; alt: string } | null = null;
if (pathLocale) {
  const featured = (await getPhotos()).find((p) => p.data.featured);
  if (!featured) throw new Error('featured: true の写真が 1 枚も無い');
  const img = await getImage({
    src: featured.data.image,
    width: OG_IMAGE_WIDTH,
    height: OG_IMAGE_HEIGHT,
    fit: 'cover',
    format: 'jpeg',
  });
  ogImage = { src: absoluteUrl(img.src, Astro.site), alt: featured.data.alt[lang] };
}
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={withBase('/favicon.svg', base)} type="image/svg+xml" />
    {alternates.map((link) => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
    {canonical && description && ogImage && (
      <>
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:site_name" content={profile.name} />
        <meta property="og:locale" content={ogLocale(lang)} />
        <meta property="og:image" content={ogImage.src} />
        <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
        <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
        <meta property="og:image:alt" content={ogImage.alt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}
    <Font cssVariable="--font-dot" />
  </head>
  <body>
    <Header lang={lang} name={profile.name} path={path} showNav={showNav} />
    <main><slot /></main>
    <Footer name={profile.name} />
  </body>
</html>
