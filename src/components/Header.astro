---
// ヘッダー 1 行: 左にロゴ（profile.name → そのロケールのトップ）、右に Photos / Career と
// 言語切り替え（相手の言語名 → 同じページの他言語版）。狭い画面では折り返すだけで
// 開閉メニューは作らない（JavaScript ゼロ。設計書 §4）。Photos / Career / 言語切り替えには
// トップ本文と同じドット絵を添える（アイコンは導線のデータが持つ）
import type { Locale } from '../lib/i18n';
import { homePath, languageSwitch, navLinks } from '../lib/site';
import PixelArt from './pixel/PixelArt.astro';

interface Props {
  lang: Locale;
  name: string;
  path: string;
  showNav?: boolean;
}

const { lang, name, path, showNav = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const sw = languageSwitch(path, lang, base);
---

<header class="dot">
  {
    showNav ? (
      <a class="logo" href={homePath(lang, base)}>
        {name}
      </a>
    ) : (
      <span class="logo">{name}</span>
    )
  }
  {
    showNav && (
      <nav>
        {navLinks(lang, base).map((link) => (
          <a href={link.href}>
            <PixelArt rows={link.icon} scale={1} />
            {link.label}
          </a>
        ))}
        <a href={sw.href} hreflang={sw.hreflang} lang={sw.hreflang}>
          <PixelArt rows={sw.icon} scale={1} />
          {sw.label}
        </a>
      </nav>
    )
  }
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding: 1rem;
    border-bottom: 1px solid var(--line);
  }
  .logo {
    font-size: 1.25rem;
    text-decoration: none;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  nav a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }
  /* 30rem 未満ではアイコンを隠してヘッダーを 1 行に保つ（design D2 追補）。
     svg は子コンポーネント PixelArt の要素でこのスコープの属性が付かないので :global で届かせる */
  @media not all and (min-width: 30rem) {
    nav :global(svg) {
      display: none;
    }
  }
</style>
