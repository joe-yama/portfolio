---
// 「© 年 名前」の 1 行だけ（PO 決定 2026-09-18）。年はビルド時の西暦
interface Props {
  name: string;
}

const { name } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="muted">© {year} {name}</footer>

<style>
  footer {
    padding: 1rem;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }
</style>
